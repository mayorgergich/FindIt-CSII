<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <GamePath>$(HOME)/.local/share/Steam/steamapps/common/Cities Skylines II</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game ships its own Cecil build; using it avoids a NuGet download. -->
    <Reference Include="Colossal.Mono.Cecil" HintPath="$(GamePath)/Cities2_Data/Managed/Colossal.Mono.Cecil.dll" Private="true" />
  </ItemGroup>

</Project>
